      m_Calls: []
  m_text: "Objective \r\nThe objective of the game is to select the cards in sequential
    order.\r\nSelect all the cards order by clicking/dragging the cards into the
    center pile\n\r\nWin Condition\r\nIf all the cards are ordered in numerical order
    (within time limit)\r\n\nFail Condition\r\nIf the player runs out of time before
    all cards are placed down.\r\nIf the player selects a card that isn\u2019t next
    in the sequence.\r\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
